{
  "name": "sinbad",
  "version": "0.0.0",
  "private": true,
  "description": "Simple analytics over dap-ts",
  "type": "module",
  "license": "MIT",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./fetch": {
      "types": "./dist/fetch.d.ts",
      "default": "./dist/fetch.js"
    },
    "./collector": {
      "types": "./dist/collector.d.ts",
      "default": "./dist/collector.js"
    }
  },
  "files": [
    "dist",
    "LICENSE"
  ],
  "scripts": {
    "prebuild": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "build": "tsc",
    "prepare": "npm run build",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.test.json",
    "lint": "biome check src test server bench",
    "format": "biome format --write src test server bench",
    "build:demo": "npm run build && esbuild demo/app.js --bundle --format=esm --outfile=demo/app.bundle.js",
    "demo": "npm run build:demo && node demo/server.js",
    "test": "vitest run",
    "test:count-server": "node test/count-server.mjs",
    "test:aggregate-server": "node test/count-server.mjs && node test/count-server.mjs sum && node test/count-server.mjs histogram",
    "bench:count": "node bench/count.mjs"
  },
  "peerDependencies": {
    "dap-ts": "*"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.13",
    "dap-ts": "file:../dap-ts",
    "esbuild": "0.28.2",
    "typescript": "7.0.2",
    "vitest": "5.0.1"
  }
}
